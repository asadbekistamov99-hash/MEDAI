{
  "name": "medai-functions",
  "description": "MedAI server: admin custom-claim verification and the server-side Gemini proxy (generateContent) that keeps GEMINI_API_KEY out of the APK",
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:all": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "set:gemini-key": "firebase functions:secrets:set GEMINI_API_KEY",
    "logs": "firebase functions:log",
    "emulators": "firebase emulators:start --only functions,firestore",
    "use": "firebase use --add"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "firebase-tools": "^13.29.1"
  },
  "private": true
}
