rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. Content Collection (Articles, health tips, popups, announcements, banners)
    // Read: Allowed for anyone (public read) so users can see health tips and banners without friction.
    // Write: Allowed only for administrators.
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Settings Collection (App Config, Feature Flags, Version Config)
    // Read: Allowed for authenticated users (to fetch config and feature flags).
    // Write: Allowed only for administrators.
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. ErrorLogs Collection (Client/server error logs)
    // Create: Allowed for authenticated users (so they can report errors securely).
    // Read: Allowed only for administrators.
    // Update/Delete: Strictly forbidden for audit integrity.
    match /errorLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 4. ApiLogs Collection (API performance & usage audit logs)
    // Create: Allowed for authenticated users (so clients can log usage telemetry).
    // Read: Allowed only for administrators.
    // Update/Delete: Strictly forbidden for logging and audit integrity.
    match /apiLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 5. AdminLogs Collection (audit trail of admin actions, written by logAdminAction())
    // Only administrators may read or write — this is the admin's own action history.
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 6. PaymentRequests Collection (premium payment proof uploads + admin review)
    // Create: A user may submit a request only under their own userId.
    // Read: The submitter may read their own requests; admins may read all (to review them).
    // Update: Only admins (approve/reject). Delete: nobody, for audit integrity.
    match /paymentRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // 7. MedicationReminders Collection (cross-device reminder sync)
    // A user may only create/read/update/delete their own reminders; admins may read all.
    match /medicationReminders/{reminderId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 8. Vitals Collection (daily heart rate / blood pressure / weight logs, cross-device sync)
    match /vitals/{vitalId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }
  }
}
